# MyPocket config. Copy to .env and fill in.

# SQLite database path. Use an ABSOLUTE path (note the four slashes).
# A relative URL like sqlite:///data/mypocket.db is resolved against the
# process's current working directory -- NOT the project root -- so launching
# from anywhere else silently opens a new, empty database.
DATABASE_URL=sqlite:////absolute/path/to/MyPocket/data/mypocket.db

# --- Teller (Citi auto-sync) ---
# Sign up at https://teller.io, download teller.zip (cert + key)
TELLER_APPLICATION_ID=app_xxxxxxxxxxxxxxxxxxxxx
TELLER_ENVIRONMENT=development
TELLER_CERT_PATH=teller/certificate.pem
TELLER_KEY_PATH=teller/private_key.pem
# TLS verification must stay enabled. An expired api.teller.io server certificate
# is a provider issue; reconnecting or replacing your client key will not fix it.

# --- E*TRADE (brokerage + Roth auto-sync) ---
# Apply at https://developer.etrade.com/getting-started
# Sandbox keys arrive in ~2-5 business days, production a bit longer.
# When you get the email with your keys, paste them here.
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=
ETRADE_ENVIRONMENT=sandbox  # switch to "production" when prod keys arrive
# Use the environment issued with your key pair. Authorization expires at
# midnight US Eastern time; reconnect in MyPocket (renewal only restores idle tokens).
# This app uses the out-of-band verifier flow, with oauth_callback=oob.

# --- Plaid (Citi, optional free Trial) ---
# Personally confirm Trial approval at https://dashboard.plaid.com/.
# Trial uses production API keys; Sandbox only previews simulated accounts.
# Enter your keys locally. Never share them in chat or commit .env.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
# Set true only after checking Dashboard shows the free Trial plan. The app
# cannot inspect your billing plan. It never upgrades or adds payment details.
PLAID_TRIAL_CONFIRMED=false
